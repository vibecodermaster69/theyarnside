# Zoho Mail SMTP (inquiry notifications)
# Host is smtp.zoho.in for the India data centre, smtp.zoho.com elsewhere.
# ZOHO_SMTP_PASSWORD must be a Zoho app-specific password, not your login password.
ZOHO_SMTP_HOST=smtp.zoho.in
ZOHO_SMTP_PORT=465
ZOHO_SMTP_USER=requests@theyarnside.in
ZOHO_SMTP_PASSWORD=
INQUIRY_TO_EMAIL=requests@theyarnside.in
